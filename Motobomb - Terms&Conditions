<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Motobomb Terms and Conditions covering accounts, community content, subscriptions, reports and safety." />
    <title>Terms & Conditions</title>
    <style>
        :root{
          --bg:#121212;
          --surface:#2A2A2A;
          --surface2:#212121;
          --text:#FFFFFF;
          --muted:rgba(255,255,255,.80);
          --muted2:rgba(255,255,255,.64);
          --divider:rgba(255,255,255,.2);
          --stroke:rgba(255,255,255,.15);
          --teal:#018786;
          --red:#810303;
          --black:#000000;
          --radius:18px;
          --shadow:0 8px 24px rgba(0,0,0,.35);
        }
        @media (prefers-color-scheme: light){ :root{ color-scheme: dark; } }
        *{box-sizing:border-box}
        html,body{height:100%}
        body{
          margin:0;
          font:16px/1.6 system-ui, -apple-system, Segoe UI, Roboto, "Helvetica Neue", Arial, "Noto Sans", "Apple Color Emoji","Segoe UI Emoji";
          background:var(--bg); color:var(--text);
          -webkit-font-smoothing:antialiased; text-rendering:optimizeLegibility;
        }
        .container{ max-width:900px; margin:0 auto; padding:24px; }
        header, main, footer{display:block}
        .page-title{
          font-size:clamp(1.65rem, 2.2vw + 1rem, 2.35rem);
          line-height:1.25; margin:8px 0 12px; letter-spacing:.2px;
        }
        .lead{ color:var(--muted); margin:0 0 22px; }
        .card{
          background:var(--surface); border:1px solid var(--stroke);
          box-shadow:var(--shadow); border-radius:var(--radius);
          padding:20px; margin:16px 0;
        }
        .hero{
          background:linear-gradient(180deg, rgba(1,135,134,.24), var(--surface));
          border:1px solid var(--stroke);
          box-shadow:var(--shadow); border-radius:26px;
          padding:22px; margin:16px 0 18px;
        }
        h2,h3{ margin:0 0 12px; line-height:1.35; }
        h2{font-size:1.25rem}
        h3{font-size:1.05rem;color:var(--muted)}
        p, ul, ol{margin:0 0 14px}
        ul, ol{padding-left:1.15rem}
        li + li{margin-top:6px}
        .divider{ height:1px;background:var(--divider);border:0;margin:16px 0; }
        a{color:#9ECFFF;text-decoration:none}
        a:hover{text-decoration:underline}
        a:focus{outline:3px solid #9ECFFF;outline-offset:2px;border-radius:6px}
        .logo{ display:block;margin:0 auto 12px auto; width:min(220px, 60%);height:auto; }
        footer{
          color:var(--muted); text-align:center;
          border-top:1px solid var(--divider);
          margin-top:24px;padding:18px 0 8px; font-size:.95rem;
        }
        .meta{color:var(--muted2);font-size:.95rem}
        .pill, .chip{
          display:inline-block; padding:6px 10px; border-radius:999px;
          background:rgba(255,255,255,.08); border:1px solid var(--stroke);
          color:var(--muted); font-size:.9rem; margin:2px 2px;
        }
        .badge-pro, .badge-free, .badge-admin, .badge-community{
          display:inline-block; padding:2px 8px; border-radius:999px;
          font-size:.8rem; font-weight:700; margin-left:6px; vertical-align:middle;
        }
        .badge-pro{background:rgba(129,3,3,.34);border:1px solid rgba(255,255,255,.14);color:#fca5a5}
        .badge-free{background:rgba(255,255,255,.10);border:1px solid var(--stroke);color:var(--muted)}
        .badge-admin{background:rgba(1,135,134,.28);border:1px solid rgba(1,135,134,.6);color:#a7f3d0}
        .badge-community{background:rgba(1,135,134,.20);border:1px solid rgba(1,135,134,.45);color:#d1fae5}
        .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:14px;margin:14px 0}
        .mini{
          background:var(--surface2);border:1px solid var(--stroke);
          border-radius:16px;padding:14px;
        }
        .mini h3{color:var(--text);margin-bottom:6px}
        .row{display:flex;gap:14px;align-items:center;margin:12px 0}
        .row img{width:44px;height:auto;border-radius:8px;border:1px solid var(--stroke)}
        .row p{margin:0;color:var(--muted)}
        .notice{
          background:rgba(129,3,3,.24);
          border:1px solid rgba(255,255,255,.14);
          border-radius:16px; padding:14px;
        }
        strong{font-weight:700}
        @media (prefers-reduced-motion: reduce){ *{transition:none} }
    </style>
    <meta name="theme-color" content="#121212">
</head>
